/target
**/*.rs.bk
*.pdb
.DS_Store
.idea/
.vscode/
*.swp
*.swo
.envrc
.direnv/

# Coverage artifacts (cargo-llvm-cov, Task 3+)
*.profraw
lcov.info
coverage/

# Misc generated artifacts
flamegraph.svg

# devt workflow state
.devt/state/

# devt agent persistent memory (per-project)
.claude/agent-memory/

# Claude Code scheduled-task PID lock — runtime state (sessionId/pid/
# acquiredAt) rewritten on every session start. Was committed by
# accident in 49d1dcb; tracking it leaks per-developer host state and
# trips `cut-release.sh`'s clean-tree precondition on every release.
.claude/scheduled_tasks.lock

# devt memory FTS5 index (regenerable from markdown)
.devt/memory/index.db

# devt memory auto-index debounce marker (transient)
.devt/memory/.auto-index-stamp

# devt MCP tool-call trace
.devt/memory/_mcp-trace.jsonl

# devt memory export bundles (transient — share via explicit channel)
.devt/memory/export-*.json

# Graphify ephemeral cache
graphify-out/cache/

# Graphify per-machine manifest
graphify-out/manifest.json

# Session-tooling artefacts — runtime state generated per developer
# by Claude Code / devt / graphify / serena / per-project MCP servers.
# Catches everything the narrow rules above didn't, after a v0.5.x
# session accidentally committed ~480k lines of these files into
# branches twice in one sitting. The narrow rules above stay for
# back-compat but are now no-ops under these broader catch-alls.
.claude/
.devt/
.serena/
.mcp.json
CLAUDE.md
.playwright-mcp/

# Graphify pipeline outputs — graphs, manifests, cost reports,
# semantic labels. All regenerable from source via `graphify build`;
# no value in tracking them and each graph.json is 100k+ lines.
graphify-out/

# Generated SPA dashboard (default --format spa --output path)
/.codelore/

# Subagent-execution scratch (ledgers, task reports) — session artifacts, never shipped
.superpowers/
