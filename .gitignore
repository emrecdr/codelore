# Misc generated artifacts
flamegraph.svg

# devt workflow state
.devt/state/

# devt agent persistent memory (per-project)
.claude/agent-memory/

# Claude Code scheduled-task PID lock — runtime state (sessionId/pid/
# acquiredAt) rewritten on every session start. Was committed by
# accident in 49d1dcb; tracking it leaks per-developer host state and
# trips `cut-release.sh`'s clean-tree precondition on every release.
.claude/scheduled_tasks.lock

# devt memory FTS5 index (regenerable from markdown)
.devt/memory/index.db

# devt memory auto-index debounce marker (transient)
.devt/memory/.auto-index-stamp

# devt MCP tool-call trace
.devt/memory/_mcp-trace.jsonl

# devt memory export bundles (transient — share via explicit channel)
.devt/memory/export-*.json

# Graphify ephemeral cache
graphify-out/cache/

# Graphify per-machine manifest
graphify-out/manifest.json

# Vendored libduckdb-sys workaround for upstream duckdb-rs#786.
# Populated by scripts/vendor-duckdb-rs.sh + patches/duckdb-rs-msvc-1940.patch
# Tracked OUT of source control because the script reproduces it deterministically.
# Remove this entry when the upstream patch ships in a released duckdb crate.
vendor/
